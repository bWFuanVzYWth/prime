{
  "schemaVersion": 1,
  "abiId": "prime-renderer-data-v1",
  "status": "stage1-contract-only",
  "coordinates": {
    "imageOrigin": "top-left",
    "pixelCenterOffset": [0.5, 0.5],
    "uvToClipScale": [2.0, -2.0],
    "uvToClipBias": [-1.0, 1.0],
    "sampleJitterUnit": "render-pixel",
    "sampleJitterPositive": ["right", "down"],
    "projectionJitterFromSample": [-1.0, -1.0],
    "visibleMotion": "previous-uv-minus-current-sample-uv",
    "visibleMotionUnit": "normalized-uv",
    "visibleMotionIncludesJitter": false,
    "coreMatrixVectorConvention": "column-vector",
    "coreMatrixStorage": "column-major",
    "streamlineMatrixStorage": "row-major-interop-only"
  },
  "color": {
    "workingSpace": "linear-rec2020-d65",
    "sourceTransfer": "iec-61966-2-1-srgb",
    "alphaTransfer": "linear",
    "mipFilterSpace": "linear-rec2020-d65",
    "linearSrgbToLinearRec2020": [
      [0.6274039, 0.3292830, 0.0433131],
      [0.0690973, 0.9195404, 0.0113623],
      [0.0163914, 0.0880133, 0.8955953]
    ]
  },
  "phases": [
    "capture",
    "translate",
    "upload",
    "trace",
    "interop-prepare",
    "reconstruction-prepare",
    "reconstruction",
    "presentation",
    "retire"
  ],
  "semantics": [
    {
      "id": "TextureId",
      "valueKind": "exact-identity",
      "components": 1,
      "domain": "scene",
      "space": "none",
      "unit": "none",
      "colorimetry": "none",
      "validity": "allocated SpriteId generation",
      "minimumEncoding": "u32-exact"
    },
    {
      "id": "MediumId",
      "valueKind": "exact-identity",
      "components": 1,
      "domain": "transport",
      "space": "none",
      "unit": "none",
      "colorimetry": "none",
      "validity": "zero is vacuum; nonzero values are stable identities",
      "minimumEncoding": "u32-exact"
    },
    {
      "id": "TangentNormalRg8",
      "valueKind": "source-faithful",
      "components": 2,
      "domain": "source-texture",
      "space": "tangent",
      "unit": "normalized-code",
      "colorimetry": "none",
      "validity": "all authored RG8 codes",
      "minimumEncoding": "rg8-unorm-exact"
    },
    {
      "id": "GeometryNormalWorld",
      "valueKind": "bounded-continuous",
      "components": 3,
      "domain": "scene-and-reconstruction",
      "space": "world",
      "unit": "unit-vector",
      "colorimetry": "none",
      "validity": "finite nonzero vector derived from submitted BLAS triangle",
      "minimumEncoding": "rgb32f-baseline"
    },
    {
      "id": "VisibleMotionUv",
      "valueKind": "bounded-continuous",
      "components": 2,
      "domain": "reconstruction",
      "space": "top-left-image",
      "unit": "normalized-uv",
      "colorimetry": "none",
      "validity": "finite when current and previous projections are valid",
      "minimumEncoding": "rg32f-baseline"
    },
    {
      "id": "LinearViewZ",
      "valueKind": "bounded-continuous",
      "components": 1,
      "domain": "reconstruction",
      "space": "view",
      "unit": "block",
      "colorimetry": "none",
      "validity": "positive finite hit distance; backend adapter owns miss encoding",
      "minimumEncoding": "r32f-baseline"
    },
    {
      "id": "LinearRec2020Radiance",
      "valueKind": "accumulated-transport",
      "components": 3,
      "domain": "transport-and-reconstruction",
      "space": "none",
      "unit": "scene-linear-radiance",
      "colorimetry": "rec2020-d65",
      "validity": "finite; negative values are preserved until an explicit boundary",
      "minimumEncoding": "rgba32f-baseline"
    },
    {
      "id": "LinearRec2020Reflectance",
      "valueKind": "bounded-continuous",
      "components": 3,
      "domain": "material",
      "space": "none",
      "unit": "ratio",
      "colorimetry": "rec2020-d65",
      "validity": "finite source-derived value with alpha kept separate",
      "minimumEncoding": "rgb32f-baseline"
    },
    {
      "id": "ExtinctionPerBlock",
      "valueKind": "bounded-continuous",
      "components": 3,
      "domain": "material-and-transport",
      "space": "none",
      "unit": "inverse-block",
      "colorimetry": "none",
      "validity": "finite nonnegative; never used as medium identity",
      "minimumEncoding": "rgb32f-baseline"
    },
    {
      "id": "RouletteEtaScale",
      "valueKind": "accumulated-transport",
      "components": 1,
      "domain": "transport",
      "space": "none",
      "unit": "dimensionless",
      "colorimetry": "none",
      "validity": "finite positive product along the active path",
      "minimumEncoding": "r32f-baseline"
    },
    {
      "id": "RayConeWidth",
      "valueKind": "bounded-continuous",
      "components": 1,
      "domain": "transport",
      "space": "view-projection",
      "unit": "block-footprint-per-block-distance",
      "colorimetry": "none",
      "validity": "finite positive primary pixel-cone spread; distance scaling is derived at the hit",
      "minimumEncoding": "half2-ray-cone-lod-audited"
    },
    {
      "id": "TextureMipBias",
      "valueKind": "bounded-continuous",
      "components": 1,
      "domain": "texture-sampling",
      "space": "texture-local",
      "unit": "mip-level",
      "colorimetry": "none",
      "validity": "finite quality-profile value; binary16 pair must keep final LOD error within 1/512 mip",
      "minimumEncoding": "half2-ray-cone-lod-audited"
    },
    {
      "id": "TextureLod",
      "valueKind": "bounded-continuous",
      "components": 1,
      "domain": "texture-sampling",
      "space": "texture-local",
      "unit": "mip-level",
      "colorimetry": "none",
      "validity": "finite value derived from declared footprint and texture extent",
      "minimumEncoding": "r32f-baseline"
    },
    {
      "id": "AreaDirectionWorld",
      "valueKind": "bounded-continuous",
      "components": 3,
      "domain": "lighting",
      "space": "world",
      "unit": "unit-vector",
      "colorimetry": "none",
      "validity": "finite normalized emitter direction",
      "minimumEncoding": "rgb32f-baseline"
    },
    {
      "id": "ShDirectionWorld",
      "valueKind": "bounded-continuous",
      "components": 3,
      "domain": "reconstruction",
      "space": "world",
      "unit": "unit-vector",
      "colorimetry": "none",
      "validity": "finite normalized SH lobe direction",
      "minimumEncoding": "rgb32f-baseline"
    },
    {
      "id": "MaterialClass",
      "valueKind": "exact-identity",
      "components": 1,
      "domain": "material-and-reconstruction",
      "space": "none",
      "unit": "enum-code",
      "colorimetry": "none",
      "validity": "declared material-class code",
      "minimumEncoding": "r8ui-reconstruction-control"
    },
    {
      "id": "ReconstructionControl",
      "valueKind": "exact-bitset",
      "components": 1,
      "domain": "reconstruction",
      "space": "none",
      "unit": "bitset",
      "colorimetry": "none",
      "validity": "bits 0-1 material class; bit 2 visible surface; bit 3 previous history; bit 4 canonical visible motion; bit 5 visible object motion; bits 6-7 zero",
      "minimumEncoding": "r8ui-reconstruction-control"
    },
    {
      "id": "VisibleHistoryPosition",
      "valueKind": "bounded-continuous",
      "components": 3,
      "domain": "trace-to-interop",
      "space": "camera-relative-world",
      "unit": "block",
      "colorimetry": "none",
      "validity": "finite previous visible position for moving objects and current position otherwise; RR transmissive motion is explicitly unavailable",
      "minimumEncoding": "rgba32f-baseline"
    },
    {
      "id": "TransportScratch",
      "valueKind": "phase-private",
      "components": 4,
      "domain": "transport",
      "space": "none",
      "unit": "none",
      "colorimetry": "none",
      "validity": "trace phase only",
      "minimumEncoding": "rgba16f-current"
    }
  ],
  "encodings": [
    {
      "id": "u32-exact",
      "scalarOrFormat": "uint32",
      "bytes": 4,
      "channelMap": "x=value",
      "encode": "identity",
      "decode": "identity",
      "exactCodes": "all-u32",
      "errorContract": "lossless"
    },
    {
      "id": "r8-unorm-exact-code",
      "scalarOrFormat": "VK_FORMAT_R8_UNORM",
      "bytes": 1,
      "channelMap": "r=code/255",
      "encode": "exact-u8-to-unorm",
      "decode": "round-saturate-times-255",
      "exactCodes": "all-u8",
      "errorContract": "lossless-for-u8-codes"
    },
    {
      "id": "r8ui-reconstruction-control",
      "scalarOrFormat": "VK_FORMAT_R8_UINT",
      "bytes": 1,
      "channelMap": "bits0-1=material,b2=surface,b3=history,b4=motion,b5=object-motion",
      "encode": "exact-bit-pack",
      "decode": "bit-mask",
      "exactCodes": "0x00-0x3f",
      "errorContract": "lossless; reserved bits must be zero"
    },
    {
      "id": "rg8-unorm-exact",
      "scalarOrFormat": "VK_FORMAT_R8G8_UNORM",
      "bytes": 2,
      "channelMap": "rg=authored-normal-codes",
      "encode": "exact-u8-to-unorm",
      "decode": "round-saturate-times-255",
      "exactCodes": "all-u8-pairs",
      "errorContract": "lossless-for-source-rg8"
    },
    {
      "id": "r32f-baseline",
      "scalarOrFormat": "VK_FORMAT_R32_SFLOAT",
      "bytes": 4,
      "channelMap": "r=value",
      "encode": "ieee754-binary32",
      "decode": "identity",
      "exactCodes": "none",
      "errorContract": "baseline-not-an-approval-for-narrowing"
    },
    {
      "id": "half2-ray-cone-lod-audited",
      "scalarOrFormat": "uint32-containing-two-ieee754-binary16-lanes",
      "bytes": 4,
      "channelMap": "low16=ray-cone-width,high16=mip-bias",
      "encode": "round-each-semantic-f32-to-nearest-binary16-at-vulkan-push-boundary",
      "decode": "unpack-binary16x2-to-binary32-before-lod-calculation",
      "exactCodes": "none",
      "errorContract": "combined-ray-cone-and-bias-error-at-most-1/512-mip"
    },
    {
      "id": "rg32f-baseline",
      "scalarOrFormat": "VK_FORMAT_R32G32_SFLOAT",
      "bytes": 8,
      "channelMap": "rg=xy",
      "encode": "ieee754-binary32",
      "decode": "identity",
      "exactCodes": "none",
      "errorContract": "baseline-not-an-approval-for-narrowing"
    },
    {
      "id": "rgb32f-baseline",
      "scalarOrFormat": "three-float32-lanes",
      "bytes": 12,
      "channelMap": "rgb=xyz",
      "encode": "ieee754-binary32",
      "decode": "identity",
      "exactCodes": "none",
      "errorContract": "baseline-not-an-approval-for-narrowing"
    },
    {
      "id": "rgba16f-candidate",
      "scalarOrFormat": "VK_FORMAT_R16G16B16A16_SFLOAT",
      "bytes": 8,
      "channelMap": "rgb=value,a=semantic-specific",
      "encode": "ieee754-binary16-candidate",
      "decode": "binary16-to-binary32",
      "exactCodes": "none",
      "errorContract": "unapproved-until-semantic-oracle-and-gpu-benchmark"
    },
    {
      "id": "rgba32f-baseline",
      "scalarOrFormat": "VK_FORMAT_R32G32B32A32_SFLOAT",
      "bytes": 16,
      "channelMap": "rgb=value,a=semantic-specific",
      "encode": "ieee754-binary32",
      "decode": "identity",
      "exactCodes": "none",
      "errorContract": "baseline-not-an-approval-for-narrowing"
    },
    {
      "id": "rgba16f-current",
      "scalarOrFormat": "VK_FORMAT_R16G16B16A16_SFLOAT",
      "bytes": 8,
      "channelMap": "rgba=phase-private",
      "encode": "current-physical-layout",
      "decode": "current-physical-layout",
      "exactCodes": "none",
      "errorContract": "characterized-current-layout-not-canonical-semantic"
    }
  ],
