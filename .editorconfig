root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{rs,java,slang}]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.{jar,zip,png,jpg,jpeg,gif,webp,ico,ttf,otf,woff,woff2,bin,safetensors,spv,dll,so,dylib,exe,pdf}]
charset = unset
end_of_line = unset
insert_final_newline = unset
