{
  "schemaVersion": 1,
  "id": "prime",
  "version": "${version}",
  "name": "Prime",
  "description": "A Vulkan hardware ray tracing shader mod for developing a path tracing renderer for Minecraft.",
  "authors": [
    "linlin"
  ],
  "license": "GPL-3.0-only with Prime linking exceptions (see LICENSE-EXCEPTIONS)",
  "environment": "client",
  "accessWidener": "prime.accesswidener",
  "entrypoints": {
    "client": [
      "dev.prime.PrimeClient"
    ]
  },
  "mixins": [
    {
      "config": "prime.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-model-loading-api-v1": "*",
    "fabric-renderer-api-v1": "*",
    "fabric-renderer-indigo": "*",
    "fabric-rendering-v1": "*",
    "fabric-resource-loader-v1": "*"
  }
}
