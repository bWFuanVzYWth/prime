#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoLogo -NoProfile -NonInteractive -File "$root/scripts/check-staged-format.ps1"
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$root/scripts/check-staged-format.ps1"
else
    echo 'Prime format hook requires PowerShell (pwsh or powershell.exe).' >&2
    exit 1
fi
